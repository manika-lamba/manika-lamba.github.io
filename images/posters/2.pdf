1436 0 obj
  << /ActualText (FINDINGS\nHighly connected network\072 99\05688\045 of artists belong to one large connected component\056\nKey connectors\072 A few creative leaders bridge creative communities across countries\056\n\n)
     /K [ 15 ]
     /P 1437 0 R
     /Pg 1406 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

1437 0 obj
  << /K [ 1436 0 R ]
     /P 1446 0 R
     /S /P
     /Pg 1406 0 R
     /Type /StructElem
  >>
endobj

1438 0 obj
  << /ActualText (Geographic patterns\072 Creative activity centers in the U\056S\056\054 U\056K\056\054 France\054 and Russia\054 with many artists producing work abroad\056\nTransnational flow\072 Ballet\031s evolution reflects migration and cross\055cultural exchange\054 core features of cultural diaspora\056\nTemporal shift in centers\072 Early networks are anchored in European capitals\054 but from the mid\05520th century onward U\056S\056 cities become key hubs\054 indicating that the U\056S\056 becomes central in ballet production\056\n)
     /K [ 16 ]
     /P 1439 0 R
     /Pg 1406 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

1439 0 obj
  << /K [ 1438 0 R ]
     /P 1446 0 R
     /S /P
     /Pg 1406 0 R
     /Type /StructElem
  >>
endobj

1440 0 obj
  << /ActualText (Cumulative ballet production over time shows the United States as the dominant center of new creations after a sharp increase between the 1930s and 1940s\054 coinciding with the emergence of American ballet through the influence of immigrant European artists\056)
     /K [ 17 ]
     /P 1441 0 R
     /Pg 1406 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

1441 0 obj
  << /K [ 1440 0 R ]
     /P 1446 0 R
     /S /P
     /Pg 1406 0 R
     /Type /StructElem
  >>
endobj

1442 0 obj
  << /ActualText (CONCLUSIONS \nUsing Wikipedia integrated with LLMs\054 we convert narrative entries into structured records to map creative mobility at scale\054 linking artists and places in ways that would be difficult to achieve by human annotators alone\056 This pipeline opens AI\055driven pathways for systematic network analysis of human mobility and cultural diaspora\054 and through more complex multi\055agent designs\054 it can be extended to other art forms and languages\056)
     /K [ 18 ]
     /P 1443 0 R
     /Pg 1406 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

